<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MirrorActivity">

    <!-- Sem scaleX no palco: View.setScaleX cria layer de hardware no API 23 e congela o preview.
         RGB espelha no canvas (Nv21PreviewView). Astra já vem OpenNI-mirrored — overlay sem flip. -->
    <com.felipe.elftemplate.tracking.Nv21PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.felipe.elftemplate.tracking.KinectDebugOverlayView
        android:id="@+id/kinect_debug_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="#66000000"
        android:paddingHorizontal="14dp"
        android:text="⬅"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</FrameLayout>
