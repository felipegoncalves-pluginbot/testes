<?xml version="1.0"?>
<ruleset name="ElfJogo Test PMD Ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Regras PMD para impedir testes vazios ou tautológicos gerados por IA.</description>

    <exclude-pattern>.*/build/.*</exclude-pattern>

    <rule ref="category/java/bestpractices.xml/JUnitTestsShouldIncludeAssert"/>
    <rule ref="category/java/bestpractices.xml/JUnitAssertionsShouldIncludeMessage">
        <properties>
            <property name="checkAssertEquals" value="false"/>
            <property name="checkAssertTrue" value="false"/>
            <property name="checkAssertFalse" value="false"/>
            <property name="checkAssertNull" value="false"/>
            <property name="checkAssertNotNull" value="false"/>
        </properties>
    </rule>

    <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>
    <rule ref="category/java/design.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="50"/>
        </properties>
    </rule>
</ruleset>
